{
  "name": "pocketto-pi",
  "version": "4.0.0",
  "description": "Pocket-driven development skills: structured subagent delegation, bug hunting, iterative planning, and code review workflows for Pi.",
  "keywords": [
    "pi-package",
    "pocket",
    "development",
    "delegation",
    "bug-hunting",
    "planning",
    "workflow",
    "skills"
  ],
  "author": {
    "name": "rfxlamia",
    "url": "https://github.com/rfxlamia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfxlamia/pocketto.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "surfaces.json",
    "skills/**",
    "!skills/**/__pycache__/**",
    "cli/**",
    "assets/**",
    "llms.txt",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/cli.test.js test/package.test.js test/lifecycle-contract.test.js test/lifecycle-store.test.js test/lifecycle-cli.test.js test/lifecycle-dispatch.test.js",
    "prepublishOnly": "echo 'Publishing pocketto to npm...'"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": []
  },
  "bin": {
    "pocketto-pi": "cli/index.js"
  }
}
